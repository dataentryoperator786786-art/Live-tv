rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function validUser() {
      return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.expiry > request.time;
    }
    match /admins/{id}   { allow read: if signed() && request.auth.uid == id; allow write: if false; }
    match /users/{id}    { allow read: if isAdmin() || (signed() && request.auth.uid == id); allow write: if isAdmin(); }
    match /channels/{id} { allow read: if isAdmin() || validUser(); allow write: if isAdmin(); }
  }
}
